# Veritas Backend — Environment Variables
# Copy this to .env and fill in your values

# Supabase (use the same project as frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Tavily Search
TAVILY_API_KEY=

# Media Cloud
MEDIACLOUD_API_KEY=

# Google Fact Check Tools
GOOGLE_FACTCHECK_API_KEY=

# App
DEBUG=true
FRONTEND_URL=http://localhost:5173
